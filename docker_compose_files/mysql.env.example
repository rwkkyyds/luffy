# ============================================
# MySQL Docker 环境变量模板
# ============================================
# 使用方法：
#   1. 复制此文件为 mysql.env（与 docker-compose.yml 同级目录的 docker_compose_files/ 下）
#   2. 将下面的占位符替换为你的真实密码
#   3. mysql.env 已被 .gitignore 排除，不会被提交到 Git
#
# 生产环境务必使用强随机密码（建议 16 位以上）
# ============================================

MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
MYSQL_DATABASE=luffy
MYSQL_USER=luffy
MYSQL_PASSWORD=CHANGE_ME_USER_PASSWORD
TZ=Asia/Shanghai

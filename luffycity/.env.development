# Vue CLI injects vars prefixed with VUE_APP_* at build time.
# 使用相对路径 + vue.config.js 的 proxy → 前端与后端不同端口仍为「同源」，避免浏览器 CORS 拦截。
# 若坚持直连 Django，可改为 http://127.0.0.1:8000/api/v1/（需后端 CorsMiddleware 顺序正确）。
VUE_APP_API_BASE_URL=/api/v1/

# 仅用于 vue.config.js 的 devServer.proxy（开发时把 /api、/media 转发到哪里）
# 必须与 python manage.py runserver 的地址一致，默认 8000，不是前端的 8080/8082
DJANGO_DEV_TARGET=http://127.0.0.1:8000

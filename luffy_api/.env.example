# ============================================
# Luffy 后端环境变量模板
# ============================================
# 使用方法：复制此文件为 .env，填入真实值

# Django 密钥（生产环境务必更换）
DJANGO_SECRET_KEY=your-secret-key-here

# 数据库（与 docker_compose_files/mysql.env 保持一致）
MYSQL_DATABASE=luffy
MYSQL_USER=luffy
MYSQL_PASSWORD=your-mysql-password
MYSQL_HOST=luffy_mysql
MYSQL_PORT=3306

# MySQL root 密码（与 mysql.env 保持一致）
PASSWORD=your-mysql-password

# 允许访问的主机（逗号分隔）
ALLOWED_HOSTS=*

# 跨域允许的源（逗号分隔，生产环境填真实域名）
CORS_ALLOWED_ORIGINS=*

# 智谱 AI API Key
ZHIPU_API_KEY=your-zhipu-api-key

# 公网地址（支付宝回调等）
# BACKEND_BASE_URL：后端公网地址，用于支付宝 notify_url 异步通知。内网穿透时改为 ngrok 地址。
BACKEND_BASE_URL=http://your-server-ip:80
# FRONTEND_BASE_URL：前端地址，用于支付宝 return_url 同步跳回。本地开发写 dev server 端口（默认8080）。
FRONTEND_BASE_URL=http://127.0.0.1:8080

# ---------- 支付宝（生产环境务必通过环境变量注入密钥，勿用 pem 文件）----------
# 应用ID（沙箱默认 2016092000554611，上线替换为正式应用ID）
ALIPAY_APP_ID=2016092000554611
# 应用私钥（PEM 格式完整内容或 Base64，开发环境可省略，自动从 pem 文件读取）
ALIPAY_APP_PRIVATE_KEY=
# 支付宝公钥（PEM 格式完整内容，开发环境可省略，自动从 pem 文件读取）
ALIPAY_PUBLIC_KEY=
# 签名算法：RSA2（推荐）或 RSA
ALIPAY_SIGN_TYPE=RSA2
# 是否使用沙箱环境（true=沙箱, false=正式）
ALIPAY_DEBUG=true
